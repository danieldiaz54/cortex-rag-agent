# Production environment template for cortex-rag-agent (copy to .env.production — never commit real secrets)
CORTEX_ENV=production
CORTEX_PORT=8090
CORTEX_SQLITE_PATH=
DATABASE_URL=postgresql://cortex_prod_app:REPLACE_WITH_VAULT_SECRET@pgvector-prod.internal:5432/cortex_rag_prod?sslmode=require
CORTEX_EMBEDDING_DIM=64
CORTEX_RRF_K=60
CORTEX_MIN_FAITHFULNESS=0.75
