# Development environment template for cortex-rag-agent (copy to .env.development — never commit real secrets)
CORTEX_ENV=development
CORTEX_PORT=8090
CORTEX_SQLITE_PATH=./.data/cortex_dev.sqlite3
DATABASE_URL=postgresql://cortex_dev:cortex_dev_local@localhost:5439/cortex_rag_dev
CORTEX_EMBEDDING_DIM=64
CORTEX_RRF_K=60
CORTEX_MIN_FAITHFULNESS=0.65
